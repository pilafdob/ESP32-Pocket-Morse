{
  "version": 1,
  "author": "Pocket Morse",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "dot", "top": 0, "left": 220, "attrs": { "color": "green", "label": "DOT / hold ERASE WORD", "key": "Q" } },
    { "type": "wokwi-pushbutton", "id": "dash", "top": 130, "left": 220, "attrs": { "color": "blue", "label": "DASH / hold ERASE LETTER", "key": "E" } },
    { "type": "wokwi-resistor", "id": "pullup", "top": 100, "left": 140, "attrs": { "value": "10000" } },
    { "type": "wokwi-text", "id": "note", "top": -70, "left": 0, "attrs": { "text": "Q+E = confirm/space; hold = SEND; 2x inbox; 3x recall; 4x dictionary.\nSerial shows modes/delivery, not message contents.\nNo ST7789 or ESP-NOW radio emulation." } }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []], ["esp:RX", "$serialMonitor:TX", "", []],
    ["esp:0", "dot:1.l", "green", []], ["dot:2.l", "esp:GND.1", "black", []],
    ["esp:35", "dash:1.l", "blue", []], ["dash:2.l", "esp:GND.1", "black", []],
    ["esp:3V3", "pullup:1", "red", []], ["pullup:2", "dash:1.l", "red", []]
  ]
}
